# Normalise line endings on checkin; check out with native endings.
* text=auto

*.cs    text eol=crlf
*.csproj text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf
*.py    text eol=lf
*.md    text
*.patch text eol=lf
*.yml   text eol=lf
LICENSE text
NOTICE  text

# Never treat these as text.
*.dll binary
*.exe binary
*.pdb binary
*.dwxmz binary
*.dwxml binary
